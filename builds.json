{
  "name": "pointrp-launcher",
  "version": "1.0.0",
  "description": "Point RP Launcher",
  "author": "Point RP",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.pointrp.launcher",
    "productName": "Point RP Launcher",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": [
      { "provider": "github", "owner": "YOUR_GITHUB_NAME", "repo": "pointrp-launcher", "releaseType": "release" }
    ]
  }
}
